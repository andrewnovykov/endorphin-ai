{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Endorphin CLI",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/endorphin.js",
      "args": [
        "run",
        "test",
        "QE-001"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/examples",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Endorphin CLI with Debug Mode",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/endorphin.js",
      "args": [
        "run",
        "test",
        "${input:testId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/examples",
      "env": {
        "NODE_ENV": "development",
        "ENDORPHIN_DEBUG": "true"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Test Recorder",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/endorphin.js",
      "args": [
        "run",
        "test-recorder"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/examples",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Framework Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/jest",
      "args": [
        "--runInBand"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "test"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Package Tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/development-tests/package-tests/run-all-tests.sh",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/development-tests/package-tests",
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "Debug Specific Test File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/framework/test-framework.js",
      "args": [
        "--test",
        "${input:testId}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Debug Browser Framework",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/framework/core/browser-framework.js",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "inputs": [
    {
      "id": "testId",
      "description": "Enter test ID (e.g., QE-001)",
      "default": "QE-001",
      "type": "promptString"
    }
  ]
}