{
  "name": "endorphin-ai",
  "version": "1.0.0",
  "description": "E2E Testing Reinvented with AI - A powerful TypeScript browser automation framework using AI-powered testing with LangChain, OpenAI GPT-4o, and Playwright",
  "main": "dist/framework/index.js",
  "bin": {
    "endorphin": "dist/bin/endorphin.js",
    "endorphin-ai": "dist/bin/endorphin.js"
  },
  "type": "module",
  "scripts": {
    "start": "tsx framework/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --passWithNoTests dev-tests/development/unit",
    "test:integration": "jest --passWithNoTests --coverage=false dev-tests/development/integration",
    "test:critical": "jest --passWithNoTests --coverage=false --testTimeout=180000 dev-tests/development/integration/critical",
    "test:dev": "jest --selectProjects='Development Tests'",
    "test:all": "jest --selectProjects='Development Tests'",
    "test:package": "cd dev-tests/package-tests && ./run-all-tests.sh",
    "build": "tsc && node scripts/fix-imports.js && cp package.json dist/ && cp framework/templates/reporter/*.html framework/templates/reporter/*.css framework/templates/reporter/*.js dist/framework/templates/reporter/ && cp -r examples dist/ && chmod +x dist/bin/endorphin.js && chmod +x dist/bin/cli-handlers.js",
    "build:watch": "tsc --watch",
    "pack:local": "npm run build && npm pack --pack-destination dist",
    "test:local": "npm run pack:local && ./dev-tests/package-tests/run-all-tests.sh",
    "test:install": "npm run build && ./scripts/test-npm-install.sh",
    "type-check": "tsc --noEmit",
    "framework:test": "tsx framework/index.ts --test",
    "framework:demo": "tsx framework/index.ts",
    "framework:all": "tsx framework/index.ts --all",
    "framework:list": "tsx framework/index.ts --list",
    "framework:auth": "tsx framework/index.ts --tag authentication",
    "framework:smoke": "tsx framework/index.ts --tag smoke",
    "framework:high": "tsx framework/index.ts --priority High",
    "test-recorder": "tsx framework/test-recorder/index.ts",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "build:clean": "rm -rf dist && npm run build",
    "dev": "tsx",
    "cleanup": "./scripts/cleanup-test-artifacts.sh",
    "postinstall": "node scripts/postinstall.js",
    "endorphin": "endorphin",
    "endorphin-ai": "endorphin-ai",
    "endorphin:init": "endorphin init",
    "endorphin:version": "endorphin --version",
    "endorphin:help": "endorphin --help",
    "endorphin-ai:init": "endorphin init",
    "endorphin-ai:version": "endorphin --version",
    "endorphin-ai:help": "endorphin --help",
    "prepare": "echo 'Husky disabled temporarily'",
    "precommit": "echo 'Pre-commit hooks disabled temporarily'",
    "prepublishOnly": "npm run build && npm run test:unit"
  },
  "keywords": [
    "ai",
    "testing",
    "e2e",
    "automation",
    "browser",
    "playwright",
    "langchain",
    "openai",
    "gpt-4",
    "test-framework",
    "typescript",
    "type-safe",
    "endorphin-ai",
    "endorphin"
  ],
  "author": "Andrew Novykov <iam@andrewnovykov.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewnovykov/endorphin-ai.git"
  },
  "homepage": "https://github.com/andrewnovykov/endorphin-ai#readme",
  "bugs": {
    "url": "https://github.com/andrewnovykov/endorphin-ai/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist/",
    "examples/",
    "scripts/",
    "README.md",
    "LICENSE.md",
    "MIGRATION-GUIDE.md"
  ],
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@langchain/community": "^0.3.31",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.46",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@playwright/mcp": "^0.0.29",
    "dotenv": "^16.4.7",
    "langchain": "^0.3.19",
    "openai": "^4.85.3",
    "playwright": "^1.50.1",
    "tsx": "^4.9.3",
    "zod": "^3.25.67"
  },
  "directories": {
    "doc": "doc",
    "example": "examples",
    "test": "tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@jest/globals": "^30.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^30.0.3",
    "jest-environment-node": "^30.0.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-transform-paths": "^3.5.5"
  },
  "types": "./dist/framework/index.d.ts"
}
