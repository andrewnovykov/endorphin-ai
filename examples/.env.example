# ====================================================================
# ENDORPHIN AI FRAMEWORK - ENVIRONMENT CONFIGURATION
# ====================================================================

# ====================================================================
# CORE CONFIGURATION (Required)
# ====================================================================

# Your OpenAI API key (Required)
# 🎯 How to get your OpenAI API key:
# 1. Go to: https://platform.openai.com/api-keys
# 2. Create new secret key
# 3. Replace the value below with your actual key
# 4. Save this file as .env (remove .example)
OPENAI_API_KEY=your_openai_api_key_here

# Base URL for your application under test
BASE_URL=https://qafromla.herokuapp.com

# ====================================================================
# DEBUG & LOGGING CONFIGURATION
# ====================================================================

# Enable debug logging (true/false/verbose)
# - false: Standard logging only
# - true: Enable debug logging
# - verbose: Enable verbose debug logging with detailed info
ENDORPHIN_DEBUG=false

# Log level (error/warn/info/debug)
ENDORPHIN_LOG_LEVEL=info

# Show detailed console output during test execution
ENDORPHIN_CONSOLE_REPORTER=false

# ====================================================================
# BROWSER CONFIGURATION
# ====================================================================

# Browser type to use for testing
# Options: chromium, firefox, webkit
ENDORPHIN_BROWSER_TYPE=chromium

# Run browser in headless mode (true/false)
ENDORPHIN_BROWSER_HEADLESS=true

# Browser operation timeout (milliseconds)
ENDORPHIN_BROWSER_TIMEOUT=30000

# Browser viewport size
ENDORPHIN_BROWSER_WIDTH=1280
ENDORPHIN_BROWSER_HEIGHT=720

# ====================================================================
# TEST EXECUTION CONFIGURATION
# ====================================================================

# Run quarantined tests (true/false)
ENDORPHIN_RUN_QUARANTINED=false

# Number of parallel workers for test execution
ENDORPHIN_PARALLEL_WORKERS=2

# Test execution timeout (milliseconds)
ENDORPHIN_TEST_TIMEOUT=60000

# Retry failed tests (number of retries)
ENDORPHIN_TEST_RETRIES=0

# ====================================================================
# AI CONFIGURATION
# ====================================================================

# OpenAI model to use
ENDORPHIN_AI_MODEL=gpt-4o

# AI temperature setting (0.0 to 2.0)
ENDORPHIN_AI_TEMPERATURE=0.1

# Maximum tokens for AI responses
ENDORPHIN_MAX_TOKENS=4000

# ====================================================================
# REPORTING CONFIGURATION
# ====================================================================

# Report format (html/json/console)
ENDORPHIN_REPORT_FORMAT=html

# Enable screenshots in reports (true/false)
ENDORPHIN_SCREENSHOTS=true

# Enable video recording (true/false)
ENDORPHIN_VIDEO_RECORDING=false

# Maximum number of reports to keep per test
ENDORPHIN_MAX_REPORTS_PER_TEST=10

# ====================================================================
# ADVANCED FEATURES
# ====================================================================

# Path to custom tools directory
ENDORPHIN_CUSTOM_TOOLS_PATH=./tools

# Path to global setup file
ENDORPHIN_GLOBAL_SETUP_PATH=./global-setup.ts

# Enable test data generation (true/false)
ENDORPHIN_ENABLE_DATA_GENERATION=true

# ====================================================================
# PERFORMANCE & OPTIMIZATION
# ====================================================================

# Enable content optimization (true/false)
ENDORPHIN_CONTENT_OPTIMIZATION=true

# Token usage optimization level (basic/advanced)
ENDORPHIN_TOKEN_OPTIMIZATION=basic

# Step delay between test actions (milliseconds)
ENDORPHIN_STEP_DELAY=1000

# ====================================================================
# DEVELOPMENT & TESTING
# ====================================================================

# Enable development mode features
ENDORPHIN_DEV_MODE=false

# Skip browser installation check
ENDORPHIN_SKIP_BROWSER_CHECK=false

# Force reinstall of browsers
ENDORPHIN_FORCE_BROWSER_INSTALL=false