{
  "name": "endorphin-ai",
  "version": "0.4.1",
  "description": "E2E Testing Reinvented with AI - A powerful browser automation framework using AI-powered testing with LangChain, OpenAI GPT-4o, and Playwright",
  "main": "framework/index.ts",
  "bin": {
    "endorphin": "./bin/endorphin.js"
  },
  "type": "module",
  "scripts": {
    "start": "node framework/test-framework.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/development/unit",
    "test:integration": "jest tests/development/integration",
    "test:dev": "jest tests/development",
    "test:all": "npm run test:dev",
    "test:package": "cd development-tests/package-tests && ./run-all-tests.sh",
    "framework:test": "node framework/test-framework.js --test",
    "framework:demo": "node framework/test-framework.js",
    "framework:all": "node framework/test-framework.js --all",
    "framework:list": "node framework/test-framework.js --list",
    "framework:auth": "node framework/test-framework.js --tag authentication",
    "framework:smoke": "node framework/test-framework.js --tag smoke",
    "framework:high": "node framework/test-framework.js --priority High",
    "test-recorder": "node framework/interactive/enhanced-interactive-recorder.js",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check",
    "quality:fix": "npm run lint:fix && npm run format",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx",
    "prepare": "echo 'Husky disabled temporarily'",
    "precommit": "echo 'Pre-commit hooks disabled temporarily'"
  },
  "keywords": [
    "ai",
    "testing",
    "e2e",
    "automation",
    "browser",
    "playwright",
    "langchain",
    "openai",
    "gpt-4",
    "test-framework"
  ],
  "author": "Andrew Novykov <iam@andrewnovykov.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewnovykov/endorphin-ai.git"
  },
  "homepage": "https://github.com/andrewnovykov/endorphin-ai#readme",
  "bugs": {
    "url": "https://github.com/andrewnovykov/endorphin-ai/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "framework/",
    "bin/",
    "examples/",
    "README.md",
    "LICENSE.md",
    "MIGRATION-GUIDE.md"
  ],
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@langchain/community": "^0.3.31",
    "@langchain/core": "^0.3.40",
    "@langchain/langgraph": "^0.2.46",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@playwright/mcp": "^0.0.29",
    "dotenv": "^16.4.7",
    "langchain": "^0.3.19",
    "openai": "^4.85.3",
    "playwright": "^1.50.1",
    "zod": "^3.25.67"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@jest/globals": "^30.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^30.0.3",
    "jest-environment-node": "^30.0.2",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}